{
  "name": "@forgely/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/bot.ts",
    "start": "node --env-file=.env dist/main.js",
    "build": "tsup",
    "deploy-commands": "tsx --env-file=.env src/scripts/deploy-commands.ts",
    "config:set": "tsx --env-file=.env src/scripts/set-module-config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@forgely/db": "workspace:^",
    "@forgely/shared": "workspace:^",
    "@sentry/node": "^11.4.0",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
