# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1556267228515794964
# Optional: register slash commands to one guild instantly instead of globally (dev only)
DISCORD_DEV_GUILD_ID=869020525853311026

# Matches docker-compose.yml
DATABASE_URL=postgres://forgely:forgely@localhost:54320/forgely
# Optional in development (falls back to an in-memory cache). Required in production.
# Start local Redis with: docker compose --profile redis up -d
REDIS_URL=

# Optional
SENTRY_DSN=
