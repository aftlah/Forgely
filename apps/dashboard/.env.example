# Copy to .env.local and fill in. Never commit .env.local.
# The landing page needs only NEXT_PUBLIC_DISCORD_CLIENT_ID. The rest arrive with login (next step).
# Runs on port 3100 (3000 is often taken by other local projects).
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# AI Server Builder (Phase 4). Free tier of the Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change fast (2.5 is already closed to new keys), so they live here, not in code.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Discord OAuth2 (same application as the bot)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Generate with: npx auth secret
AUTH_SECRET=

DATABASE_URL=postgres://forgely:forgely@localhost:54320/forgely
# Optional in development. Required to push config changes to the running bot instantly.
REDIS_URL=
